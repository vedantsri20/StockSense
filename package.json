{
  "name": "stocksense-root",
  "version": "1.0.0",
  "private": true,
  "description": "StockSense – Enterprise Inventory Management System",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "predev": "node scripts/clean-ports.js",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue.bold,green.bold\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "seed": "npm run seed --workspace=backend",
    "build": "npm run build --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
